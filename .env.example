# Copy to .env (gitignored) and fill in locally. Never commit real values.

# LLM (Gemini via google-genai)
GEMINI_API_KEY=
AGENT_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=60
MAX_TOOL_ROUNDS=8

# Agent behaviour
LOG_LEVEL=INFO
TOOL_TIMEOUT_SECONDS=20

# DVC / git provenance (repo root and where reproduced datasets are written)
PROJECT_DIR=.
SCRATCH_DIR=scratch

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=breast-cancer-classification
MODEL_NAME=breast-cancer-classifier
QUALITY_GATE_F1=0.90
FRESHNESS_MAX_DAYS=7
# MLflow client fail-fast (defaults applied by the agent if unset)
MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
MLFLOW_HTTP_REQUEST_TIMEOUT=10

# Airflow 3 (docker compose reads these; generate your own random values)
AIRFLOW_URL=http://localhost:8080
AIRFLOW_UID=1000
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_DB_PASSWORD=
AIRFLOW_ALLOWED_DAGS=training_pipeline

# Kubernetes (kubeconfig from ~/.kube/config; never commit kubeconfigs)
K8S_APPROVED_NAMESPACE=mlops
KUBE_CONTEXT=kind-mlops

# Silence MLflow assistant hints in logs
MLFLOW_DISABLE_AGENT_HINT=1
